# Copy this file to `.env` and fill in real values. `.env` is gitignored on purpose —
# credentials never belong in version control (see config/env.js for why this file
# is the *only* place that reads process.env directly).

PORT=5000
NODE_ENV=development

# Local MongoDB, or an Atlas SRV connection string in production.
MONGO_URI=mongodb://127.0.0.1:27017/taskflow

# Access tokens are short-lived (minutes) — stolen tokens expire fast.
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m

# Refresh tokens are long-lived (days) but are revocable server-side because we
# persist them in MongoDB (see models/RefreshToken.js).
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# Must match the Vite dev server origin exactly — CORS with credentials:true
# rejects wildcard origins.
CLIENT_ORIGIN=http://localhost:5173
